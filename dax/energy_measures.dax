
-- Ireland Energy Analytics Dashboard
-- Power BI DAX Measures
-- Source: gold_primary_energy_supply

-- 1. Total Energy
Total Energy (ktoe) =
SUM(
    gold_primary_energy_supply[total_energy_ktoe]
)

-- 2. Distinct Fuel Types
Distinct Fuel Types =
DISTINCTCOUNT(
    gold_primary_energy_supply[fuel_type]
)

-- 3. Renewable Energy
Renewable Energy (ktoe) =
CALCULATE(
    [Total Energy (ktoe)],
    REMOVEFILTERS(
        gold_primary_energy_supply[fuel_type]
    ),
    FILTER(
        ALL(gold_primary_energy_supply[fuel_type]),
        LOWER(TRIM(gold_primary_energy_supply[fuel_type]))
            = "renewables"
    )
)

-- 4. Renewable Energy Share
Renewable Energy Share =
VAR AllEnergy =
    CALCULATE(
        [Total Energy (ktoe)],
        REMOVEFILTERS(
            gold_primary_energy_supply[fuel_type]
        )
    )
RETURN
    DIVIDE(
        [Renewable Energy (ktoe)],
        AllEnergy,
        0
    )

-- 5. Top Fuel Type
Top Fuel Type =
VAR FuelRanking =
    ADDCOLUMNS(
        ALLSELECTED(
            gold_primary_energy_supply[fuel_type]
        ),
        "@Energy", [Total Energy (ktoe)]
    )
VAR TopFuel =
    TOPN(
        1,
        FuelRanking,
        [@Energy], DESC,
        gold_primary_energy_supply[fuel_type], ASC
    )
RETURN
    CONCATENATEX(
        TopFuel,
        gold_primary_energy_supply[fuel_type],
        ", "
    )
